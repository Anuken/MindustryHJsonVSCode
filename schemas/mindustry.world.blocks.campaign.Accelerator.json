{
  "superclass": "mindustry.world.Block",
  "arrowRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "selectArrowRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "launchBlock":{
    "type": "mindustry.world.Block",
    "doc": "Core block that is launched. Should match the starting core of the planet being launched to.",
    "default": "coreNucleus"
  },
  "powerBufferRequirement":{
    "type": "float"
  },
  "launchCandidates":{
    "type": "arc.struct.Seq<mindustry.type.Planet>",
    "nullable": true,
    "doc": "Override for planets that this block can launch to. If null, the planet's launch candidates are used."
  },
  "lightningSound":{
    "type": "arc.audio.Sound"
  },
  "lightningSoundVolume":{
    "type": "float",
    "default": "85"
  },
  "chargeSound":{
    "type": "arc.audio.Sound",
    "default": "acceleratorCharge"
  },
  "launchSound":{
    "type": "arc.audio.Sound",
    "default": "acceleratorLaunch"
  },
  "constructSound":{
    "type": "arc.audio.Sound",
    "default": "acceleratorConstruct"
  },
  "launchDuration":{
    "type": "float",
    "default": "120"
  },
  "chargeDuration":{
    "type": "float",
    "default": "220"
  },
  "buildDuration":{
    "type": "float",
    "default": "120"
  },
  "landZoomInterp":{
    "type": "arc.math.Interp",
