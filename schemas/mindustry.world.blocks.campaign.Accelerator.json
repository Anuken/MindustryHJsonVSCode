  },
  "chargeZoomInterp":{
    "type": "arc.math.Interp",
    "default": "pow4In"
  },
  "landZoomFrom":{
    "type": "float",
    "default": "02"
  },
  "landZoomTo":{
    "type": "float",
    "default": "02"
  },
  "chargeZoomTo":{
    "type": "float",
    "default": "02"
  },
  "chargeRings":{
    "type": "int",
    "default": "4"
  },
  "ringRadBase":{
    "type": "float",
    "default": "60"
  },
  "ringRadSpacing":{
    "type": "float",
    "default": "60"
  },
  "ringRadPow":{
    "type": "float",
    "default": "60"
  },
  "ringStroke":{
    "type": "float",
    "default": "60"
  },
  "ringSpeedup":{
    "type": "float",
    "default": "60"
  },
  "chargeRingMerge":{
    "type": "float",
    "default": "60"
  },
  "ringArrowRad":{
    "type": "float",
    "default": "60"
  },
  "ringHandleTilt":{
    "type": "float",
    "default": "8"
  },
  "ringHandleLen":{
    "type": "float",
    "default": "8"
  },
  "ringColor":{
    "type": "arc.graphics.Color",
    "default": "accent"
  },
  "launchLightning":{
    "type": "int",
    "default": "20"
  },
  "lightningColor":{
    "type": "arc.graphics.Color",
    "default": "accent"
  },
  "lightningDamage":{
    "type": "float",
    "default": "40"
  },
  "lightningOffset":{
    "type": "float",
    "default": "24"
  },
  "lightningLengthMin":{
    "type": "int",
    "default": "5"
  },
  "lightningLengthMax":{
    "type": "int",
    "default": "5"
  },
  "lightningLaunchChance":{
    "type": "double",
    "default": "8"
  }
