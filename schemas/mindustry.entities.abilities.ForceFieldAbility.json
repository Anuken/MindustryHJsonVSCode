{
  "superclass": "mindustry.entities.abilities.Ability",
  "radius":{
    "type": "float",
    "doc": "Shield radius.",
    "default": "60"
  },
  "regen":{
    "type": "float",
    "doc": "Shield regen speed in damage/tick.",
    "default": "1"
  },
  "max":{
    "type": "float",
    "doc": "Maximum shield.",
    "default": "200"
  },
  "cooldown":{
    "type": "float",
    "doc": "Cooldown after the shield is broken, in ticks.",
    "default": "60f * 5"
  },
  "sides":{
    "type": "int",
    "doc": "Sides of shield polygon.",
    "default": "6"
  },
  "rotation":{
    "type": "float",
    "doc": "Rotation of shield.",
    "default": "0"
  },
  "breakSound":{
    "type": "arc.audio.Sound",
    "default": "shieldBreakSmall"
  },
  "hitSound":{
    "type": "arc.audio.Sound",
    "default": "shieldHit"
  },
  "hitSoundVolume":{
    "type": "float",
    "default": "12"
  },
  "display":{
    "type": "boolean",
    "doc": "If false, this ability does not show in unit stats.",
    "default": "true"
  },
  "data":{
    "type": "float"
  }
}