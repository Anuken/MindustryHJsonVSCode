{
  "superclass": "java.lang.Object",
  "doc": "Handles different types of bullet patterns for shooting.\n",
  "shots":{
    "type": "int",
    "doc": "amount of shots per \"trigger pull\"",
    "default": "1"
  },
  "firstShotDelay":{
    "type": "float",
    "doc": "delay in ticks before first shot",
    "default": "0"
  },
  "shotDelay":{
    "type": "float",
    "doc": "delay in ticks between shots",
    "default": "0"
  }
}