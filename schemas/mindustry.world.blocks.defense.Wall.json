{
  "superclass": "mindustry.world.Block",
  "lightningChance":{
    "type": "float",
    "doc": "Lighting chance. -1 to disable",
    "default": "-1"
  },
  "lightningDamage":{
    "type": "float",
    "default": "20"
  },
  "lightningLength":{
    "type": "int",
    "default": "17"
  },
  "lightningColor":{
    "type": "arc.graphics.Color",
    "default": "surge"
  },
  "lightningSound":{
    "type": "arc.audio.Sound",
    "default": "shootArc"
  },
  "chanceDeflect":{
    "type": "float",
    "doc": "Bullet deflection chance. -1 to disable",
    "default": "-1"
  },
  "flashHit":{
    "type": "boolean"
  },
  "flashColor":{
    "type": "arc.graphics.Color",
    "default": "white"
  },
  "deflectSound":{
    "type": "arc.audio.Sound",
    "default": "none"
  },
  "autotile":{
    "type": "boolean",
    "doc": "If true, this block uses autotiling; variants are not supported. See https://github.com/GglLfr/tile-gen",
    "default": "false"
  }
}