    "type": "float",
    "default": "2"
  },
  "radius":{
    "type": "float",
    "default": "6"
  },
  "length":{
    "type": "float",
    "default": "6"
  },
  "x":{
    "type": "float",
    "default": "6"
  },
  "y":{
    "type": "float",
    "default": "6"
  },
  "layerSpeed":{
    "type": "float",
    "default": "6"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
