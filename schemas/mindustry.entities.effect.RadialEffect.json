{
  "superclass": "mindustry.entities.Effect",
  "doc": "Renders one particle effect repeatedly at specified angle intervals.\n",
  "effect":{
    "type": "mindustry.entities.Effect",
    "default": "none"
  },
  "rotationSpacing":{
    "type": "float",
    "default": "90"
  },
  "rotationOffset":{
    "type": "float",
    "default": "90"
  },
  "effectRotationOffset":{
    "type": "float",
    "default": "90"
  },
  "lengthOffset":{
    "type": "float",
    "default": "0"
  },
  "amount":{
    "type": "int",
    "default": "4"
  }
}