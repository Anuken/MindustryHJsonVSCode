{
  "superclass": "mindustry.entities.Effect",
  "doc": "Renders one particle effect repeatedly at specified angle intervals.\n",
  "effect":{
    "type": "mindustry.entities.Effect",
    "default": "none"
  },
  "rotationSpacing":{
    "type": "float",
    "default": "90"
  },
  "rotationOffset":{
    "type": "float",
    "default": "90"
  },
  "effectRotationOffset":{
    "type": "float",
    "default": "90"
  },
  "lengthOffset":{
    "type": "float",
    "default": "0"
  },
  "amount":{
    "type": "int",
    "default": "4"
  },
  "id":{
    "type": "int"
  },
  "renderer":{
    "type": "arc.func.Cons<mindustry.entities.Effect$EffectContainer>"
  },
  "lifetime":{
    "type": "float",
    "default": "50"
  },
  "clip":{
    "type": "float",
    "doc": "Clip size."
  },
  "startDelay":{
    "type": "float",
    "doc": "Time delay before the effect starts"
  },
  "baseRotation":{
    "type": "float",
    "doc": "Amount added to rotation"
  },
  "followParent":{
    "type": "boolean",
    "doc": "If true, parent unit is data are followed.",
    "default": "true"
  },
  "rotWithParent":{
    "type": "boolean",
    "doc": "If this and followParent are true, the effect will offset and rotate with the parent's rotation."
  },
  "layer":{
    "type": "float",
    "default": "effect"
  },
  "layerDuration":{
    "type": "float"
  }
}