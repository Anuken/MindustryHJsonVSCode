{
  "superclass": "mindustry.entities.abilities.Ability",
  "plateRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "shineRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "plateSuffix":{
    "type": "java.lang.String",
    "default": "\"-armor\""
  },
  "shineSuffix":{
    "type": "java.lang.String",
    "default": "\"-shine\""
  },
  "color":{
    "type": "arc.graphics.Color",
    "nullable": true,
    "doc": "Color of the shine. If null, uses team color.",
    "default": "null"
  },
  "shineSpeed":{
    "type": "float",
    "default": "1"
  },
  "z":{
    "type": "float",
    "default": "-1"
  },
  "drawPlate":{
    "type": "boolean",
    "doc": "Whether to draw the plate region.",
    "default": "true"
  },
  "drawShine":{
    "type": "boolean",
    "doc": "Whether to draw the shine over the plate region.",
    "default": "true"
  },
  "healthMultiplier":{
    "type": "float",
    "default": "2"
  },
  "display":{
    "type": "boolean",
    "doc": "If false, this ability does not show in unit stats.",
    "default": "true"
  },
  "data":{
    "type": "float"
  }
}