{
  "superclass": "mindustry.world.Block",
  "range":{
    "type": "float",
    "default": "80"
  },
  "placeOverlapMargin":{
    "type": "float",
    "default": "8 * 7"
  },
  "rotateSpeed":{
    "type": "float",
    "default": "5"
  },
  "fogRadiusMultiplier":{
    "type": "float",
    "default": "1"
  },
  "disableOverlapCheck":{
    "type": "boolean",
    "default": "false"
  },
  "activationTime":{
    "type": "float",
    "doc": "How much time to start shooting after placement.",
    "default": "0"
  },
  "coolEffect":{
    "type": "mindustry.entities.Effect",
    "doc": "Effect displayed when coolant is used.",
    "default": "fuelburn"
  },
  "coolantMultiplier":{
    "type": "float",
    "doc": "How much reload is lowered by for each unit of liquid of heat capacity.",
    "default": "5"
  },
  "coolant":{
    "type": "mindustry.world.consumers.ConsumeLiquidBase",
    "nullable": true,
    "doc": "If not null, this consumer will be used for coolant."
  }
}