{
  "superclass": "mindustry.world.draw.DrawBlock",
  "emptyRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "fullRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "suffix":{
    "type": "java.lang.String",
    "default": "\"-power\""
  },
  "drawPlan":{
    "type": "boolean",
    "default": "true"
  },
  "mixcol":{
    "type": "boolean",
    "doc": "If false, fades between emptyRegion and fullRegion instead of mixcol between empty and full colors.",
    "default": "true"
  },
  "emptyLightColor":{
    "type": "arc.graphics.Color"
  },
  "fullLightColor":{
    "type": "arc.graphics.Color"
  },
  "layer":{
    "type": "float",
    "doc": "Any number <=0 disables layer changes.",
    "default": "-1"
  }
}