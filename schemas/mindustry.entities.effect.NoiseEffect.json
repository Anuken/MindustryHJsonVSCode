{
  "superclass": "mindustry.entities.Effect",
  "doc": "Effect that renders noise layers over the camera view.\n",
  "noisePath":{
    "type": "java.lang.String",
    "default": "png\""
  },
  "color":{
    "type": "arc.graphics.Color",
    "nullable": true
  },
  "noiseScl":{
    "type": "float",
    "default": "1000"
  },
  "opacity":{
    "type": "float",
    "default": "3"
  },
  "baseSpeed":{
    "type": "float",
    "default": "4"
  },
  "intensity":{
    "type": "float",
    "default": "1"
  },
  "windX":{
    "type": "float",
    "default": "1"
  },
  "windY":{
    "type": "float",
    "default": "0"
  },
