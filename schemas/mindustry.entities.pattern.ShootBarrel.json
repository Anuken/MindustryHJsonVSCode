{
  "superclass": "mindustry.entities.pattern.ShootPattern",
  "barrels":{
    "type": "float[]",
    "doc": "barrels [in x, y, rotation] format.",
    "default": "{ 0f, 0f, 0f }"
  },
  "barrelOffset":{
    "type": "int",
    "doc": "offset of barrel to start on",
    "default": "0"
  },
  "shots":{
    "type": "int",
    "doc": "amount of shots per \"trigger pull\"",
    "default": "1"
  },
  "firstShotDelay":{
    "type": "float",
    "doc": "delay in ticks before first shot",
    "default": "0"
  },
  "shotDelay":{
    "type": "float",
    "doc": "delay in ticks between shots",
    "default": "0"
  }
}