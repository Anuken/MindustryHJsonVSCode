    "default": "5"
  },
  "sides":{
    "type": "int",
    "default": "5"
  },
  "strokeMin":{
    "type": "float",
    "default": "2"
  },
  "strokeMax":{
    "type": "float",
    "default": "2"
  },
  "timeScl":{
    "type": "float",
    "default": "2"
  },
  "radius":{
    "type": "float",
    "default": "12"
  },
  "radiusOffset":{
    "type": "float",
    "default": "12"
  },
  "x":{
    "type": "float",
    "default": "12"
  },
  "y":{
    "type": "float",
    "default": "12"
  },
  "strokeInterp":{
    "type": "arc.math.Interp",
    "default": "pow3In"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
