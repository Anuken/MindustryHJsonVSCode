{
  "superclass": "mindustry.world.draw.DrawBlock",
  "flameColor":{
    "type": "arc.graphics.Color"
  },
  "midColor":{
    "type": "arc.graphics.Color"
  },
  "flameRad":{
    "type": "float",
    "default": "1"
  },
  "circleSpace":{
    "type": "float",
    "default": "1"
  },
  "flameRadiusScl":{
    "type": "float",
    "default": "1"
  },
  "flameRadiusMag":{
    "type": "float",
    "default": "1"
  },
  "circleStroke":{
    "type": "float",
    "default": "1"
  },
  "x":{
    "type": "float",
    "default": "0"
  },
  "y":{
    "type": "float",
    "default": "0"
  },
  "alpha":{
    "type": "float",
    "default": "68"
  },
  "particles":{
    "type": "int",
    "default": "25"
  },
  "particleLife":{
    "type": "float",
    "default": "40"
  },
  "particleRad":{
    "type": "float",
    "default": "40"
  },
  "particleStroke":{
    "type": "float",
    "default": "40"
  },
  "particleLen":{
    "type": "float",
    "default": "40"
  },
  "drawCenter":{
    "type": "boolean",
    "default": "true"
  },
  "blending":{
    "type": "arc.graphics.Blending",
    "default": "additive"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
    "nullable": true,
    "doc": "If set, the icon is overridden to be these strings, in order. Each string is a suffix.",
    "default": "null"
  }
}