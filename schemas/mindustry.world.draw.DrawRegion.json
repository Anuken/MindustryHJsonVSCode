{
  "superclass": "mindustry.world.draw.DrawBlock",
  "region":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "suffix":{
    "type": "java.lang.String",
    "default": "\"\""
  },
  "name":{
    "type": "java.lang.String",
    "nullable": true,
    "doc": "If set, overrides the region name."
  },
  "color":{
    "type": "arc.graphics.Color",
    "nullable": true
  },
  "spinSprite":{
    "type": "boolean",
    "default": "false"
  },
  "drawPlan":{
    "type": "boolean",
    "default": "true"
  },
  "buildingRotate":{
    "type": "boolean",
    "default": "false"
  },
  "rotateSpeed":{
    "type": "float"
  },
  "x":{
    "type": "float"
  },
  "y":{
    "type": "float"
  },
  "rotation":{
    "type": "float"
  },
  "layer":{
    "type": "float",
    "doc": "Any number <=0 disables layer changes.",
    "default": "-1"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
    "nullable": true,
    "doc": "If set, the icon is overridden to be these strings, in order. Each string is a suffix.",
    "default": "null"
  }
}