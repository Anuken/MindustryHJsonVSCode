{
  "superclass": "mindustry.world.blocks.payloads.PayloadBlock",
  "sideRegion1":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "sideRegion2":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "areaSize":{
    "type": "int",
    "default": "11"
  },
  "droneType":{
    "type": "mindustry.type.UnitType",
    "doc": "Note: The spawned unit MUST have AssemblerAI as a controller and 'tether' (BuildingTetherComp) as a unit component.",
    "default": "assemblyDrone"
  },
  "dronesCreated":{
    "type": "int",
    "default": "4"
  },
  "droneConstructTime":{
    "type": "float",
    "default": "60f * 4"
  },
  "capacities":{
    "type": "int[]",
    "default": "[]"
  },
  "plans":{
    "type": "arc.struct.Seq<mindustry.world.blocks.units.UnitAssembler$AssemblerUnitPlan>"
  },
  "createSound":{
    "type": "arc.audio.Sound",
    "default": "unitCreateBig"
  },
  "createSoundVolume":{
    "type": "float",
    "default": "1"
  }
}