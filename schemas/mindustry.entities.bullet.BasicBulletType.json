{
  "superclass": "mindustry.entities.bullet.BulletType",
  "doc": "An extended BulletType for most ammo-based bullets shot from turrets and units. Draws 1-2 sprites that can spin or shrink.\n",
  "backColor":{
    "type": "arc.graphics.Color",
    "default": "bulletYellowBack"
  },
  "frontColor":{
    "type": "arc.graphics.Color",
    "default": "bulletYellowBack"
  },
  "mixColorFrom":{
    "type": "arc.graphics.Color"
  },
  "mixColorTo":{
    "type": "arc.graphics.Color"
  },
  "width":{
    "type": "float",
    "default": "5"
  },
  "height":{
    "type": "float",
    "default": "5"
  },
  "shrinkX":{
    "type": "float",
    "default": "0"
  },
  "shrinkY":{
    "type": "float",
    "default": "0"
  },
  "shrinkInterp":{
    "type": "arc.math.Interp",
    "default": "linear"
  },
  "spin":{
    "type": "float",
    "default": "0"
  },
  "rotationOffset":{
    "type": "float",
    "default": "0"
  },
  "sprite":{
    "type": "java.lang.String"
  },
  "backSprite":{
    "type": "java.lang.String",
    "nullable": true
  },
  "backRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "frontRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  }
}