{
  "superclass": "mindustry.world.blocks.power.PowerGenerator",
  "timerFuel":{
    "type": "int",
    "default": "timers++"
  },
  "lightColor":{
    "type": "arc.graphics.Color"
  },
  "coolColor":{
    "type": "arc.graphics.Color"
  },
  "hotColor":{
    "type": "arc.graphics.Color"
  },
  "itemDuration":{
    "type": "float",
    "doc": "ticks to consume 1 fuel",
    "default": "120"
  },
  "heating":{
    "type": "float",
    "doc": "heating per frame * fullness",
    "default": "01"
  },
  "heatOutput":{
    "type": "float",
    "doc": "max heat this block can output per side",
    "default": "12"
  },
  "heatWarmupRate":{
    "type": "float",
    "doc": "rate at which heat progress increases",
    "default": "1"
  },
  "heatConsumeRate":{
    "type": "float",
    "doc": "rate at which fuel consumption scales with heat",
    "default": "10"
  },
  "ambientCooldownTime":{
    "type": "float",
    "doc": "time taken to cool down if no fuel is inputted even if coolant is not present",
    "default": "60f * 20"
  },
  "smokeThreshold":{
    "type": "float",
    "doc": "threshold at which block starts smoking",
    "default": "3"
  },
  "flashThreshold":{
    "type": "float",
    "doc": "heat threshold at which lights start flashing",
    "default": "46"
  },
  "coolantPower":{
    "type": "float",
    "doc": "heat removed per unit of coolant",
    "default": "5"
  },
  "fuelItem":{
    "type": "mindustry.type.Item",
    "default": "thorium"
  },
  "topRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "lightsRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  }
}