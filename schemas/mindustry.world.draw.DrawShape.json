{
  "superclass": "mindustry.world.draw.DrawBlock",
  "color":{
    "type": "arc.graphics.Color"
  },
  "sides":{
    "type": "int",
    "default": "4"
  },
  "radius":{
    "type": "float",
    "default": "2"
  },
  "timeScl":{
    "type": "float",
    "default": "2"
  },
  "layer":{
    "type": "float",
    "default": "2"
  },
  "x":{
    "type": "float",
    "default": "2"
  },
  "y":{
    "type": "float",
    "default": "2"
  },
  "useWarmupRadius":{
    "type": "boolean",
    "default": "false"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
    "nullable": true,
    "doc": "If set, the icon is overridden to be these strings, in order. Each string is a suffix.",
    "default": "null"
  }
}