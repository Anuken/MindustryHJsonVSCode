{
  "superclass": "mindustry.world.Block",
  "regions":{
    "type": "arc.graphics.g2d.TextureRegion[]"
  },
  "edgeRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "stackRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "glowRegion":{
    "type": "arc.graphics.g2d.TextureRegion",
    "doc": "requires power to work properly"
  },
  "edgeGlowRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "glowAlpha":{
    "type": "float",
    "default": "1"
  },
  "glowColor":{
    "type": "arc.graphics.Color",
    "default": "redLight"
  },
  "baseEfficiency":{
    "type": "float",
    "default": "0"
  },
  "speed":{
    "type": "float",
    "default": "0"
  },
  "outputRouter":{
    "type": "boolean",
    "default": "true"
  },
  "recharge":{
    "type": "float",
    "doc": "(minimum) amount of loading docks needed to fill a line.",
    "default": "2"
  },
  "loadEffect":{
    "type": "mindustry.entities.Effect",
    "default": "conveyorPoof"
  },
  "unloadEffect":{
    "type": "mindustry.entities.Effect",
    "default": "conveyorPoof"
  }
}