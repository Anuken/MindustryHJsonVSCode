{
  "superclass": "mindustry.world.blocks.storage.StorageBlock",
  "thruster1":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "thruster2":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "thrusterLength":{
    "type": "float",
    "default": "14f / 4"
  },
  "thrusterOffset":{
    "type": "float",
    "default": "14f / 4"
  },
  "isFirstTier":{
    "type": "boolean"
  },
  "allowSpawn":{
    "type": "boolean",
    "doc": "If false, players can't respawn at this core.",
    "default": "true"
  },
  "requiresCoreZone":{
    "type": "boolean",
    "doc": "If true, this core type requires a core zone to upgrade."
  },
  "incinerateNonBuildable":{
    "type": "boolean",
    "default": "false"
  },
  "unitType":{
    "type": "mindustry.type.UnitType",
    "default": "alpha"
  },
  "landDuration":{
    "type": "float",
    "default": "160"
  },
  "landMusic":{
    "type": "arc.audio.Music",
    "default": "land"
  },
  "launchSoundVolume":{
    "type": "float",
    "default": "1"
  },
  "landSoundVolume":{
    "type": "float",
    "default": "1"
  },
  "launchSound":{
    "type": "arc.audio.Sound",
    "default": "coreLaunch"
  },
  "landSound":{
    "type": "arc.audio.Sound",
    "default": "coreLand"
  },
  "launchEffect":{
    "type": "mindustry.entities.Effect",
    "default": "launch"
  },
  "landZoomInterp":{
    "type": "arc.math.Interp",
    "default": "pow3"
  },
  "landZoomFrom":{
    "type": "float",
    "default": "02"
  },
  "landZoomTo":{
    "type": "float",
    "default": "02"
  },
  "captureInvicibility":{
    "type": "float",
    "default": "60f * 15"
  }
}