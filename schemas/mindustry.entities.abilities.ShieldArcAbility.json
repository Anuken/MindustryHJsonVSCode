{
  "superclass": "mindustry.entities.abilities.Ability",
  "radius":{
    "type": "float",
    "doc": "Shield radius.",
    "default": "60"
  },
  "regen":{
    "type": "float",
    "doc": "Shield regen speed in damage/tick.",
    "default": "1"
  },
  "max":{
    "type": "float",
    "doc": "Maximum shield.",
    "default": "200"
  },
  "cooldown":{
    "type": "float",
    "doc": "Cooldown after the shield is broken, in ticks.",
    "default": "60f * 5"
  },
  "angle":{
    "type": "float",
    "doc": "Angle of shield arc.",
    "default": "80"
  },
  "angleOffset":{
    "type": "float",
    "doc": "Offset parameters for shield.",
    "default": "0"
  },
  "x":{
    "type": "float",
    "doc": "Offset parameters for shield.",
    "default": "0"
  },
  "y":{
    "type": "float",
    "doc": "Offset parameters for shield.",
    "default": "0"
  },
  "whenShooting":{
    "type": "boolean",
    "doc": "If true, only activates when shooting.",
    "default": "true"
  },
  "width":{
    "type": "float",
    "doc": "Width of shield line.",
    "default": "6"
  },
  "chanceDeflect":{
    "type": "float",
    "doc": "Bullet deflection chance. -1 to disable",
    "default": "-1"
  },
  "reflectBuildingDamage":{
    "type": "float",
    "doc": "Multiplier for reflected bullet building damage. -1 to disable",
    "default": "1"
  },
  "reflectVel":{
    "type": "float",
    "doc": "Velocity multiplier for reflected bullets on the opposite axis. Negative values = concave, positive values = convex",
    "default": "1"
  },
  "reflectTime":{
    "type": "float",
    "doc": "Time multiplier for reflected bullets.",
    "default": "5"
  },
  "deflectSound":{
    "type": "arc.audio.Sound",
    "doc": "Deflection sound.",
    "default": "none"
  },
  "breakSound":{
    "type": "arc.audio.Sound",
    "default": "shieldBreakSmall"
  },
  "hitSound":{
    "type": "arc.audio.Sound",
    "default": "shieldHit"
  },
  "hitSoundVolume":{
    "type": "float",
    "default": "12"
  },
  "missileUnitMultiplier":{
    "type": "float",
    "doc": "Multiplier for shield damage taken from missile units.",
    "default": "2"
  },
  "drawArc":{
    "type": "boolean",
    "doc": "Whether to draw the arc line.",
    "default": "true"
  },
  "region":{
    "type": "java.lang.String",
    "nullable": true,
    "doc": "If not null, will be drawn on top."
  },
  "color":{
    "type": "arc.graphics.Color",
    "nullable": true,
    "doc": "Color override of the shield. Uses unit shield colour by default."
  },
  "offsetRegion":{
    "type": "boolean",
    "doc": "If true, sprite position will be influenced by x/y.",
    "default": "false"
  },
  "pushUnits":{
    "type": "boolean",
    "doc": "If true, enemy units are pushed out.",
    "default": "true"
  },
  "pushEffect":{
    "type": "mindustry.entities.Effect",
    "default": "circleColorSpark"
  }
}