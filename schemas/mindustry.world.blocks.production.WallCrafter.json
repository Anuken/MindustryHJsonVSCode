{
  "superclass": "mindustry.world.Block",
  "topRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "rotatorBottomRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "rotatorRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "drillTime":{
    "type": "float",
    "doc": "Time to produce one item at 100% efficiency.",
    "default": "150"
  },
  "liquidBoostIntensity":{
    "type": "float",
    "doc": "How many times faster the drill will progress when boosted by liquid.",
    "default": "6"
  },
  "updateEffect":{
    "type": "mindustry.entities.Effect",
    "doc": "Effect randomly played while drilling.",
    "default": "mineWallSmall"
  },
  "updateEffectChance":{
    "type": "float",
    "default": "02"
  },
  "rotateSpeed":{
    "type": "float",
    "default": "2"
  },
  "attribute":{
    "type": "mindustry.world.meta.Attribute",
    "doc": "Attribute to check for wall output.",
    "default": "sand"
  },
  "output":{
    "type": "mindustry.type.Item",
    "default": "sand"
  },
  "boostItemUseTime":{
    "type": "float",
    "default": "120"
  },
  "itemBoostIntensity":{
    "type": "float",
    "doc": "How many times faster the drill will progress when boosted by items. Note: Using item and liquid boosters at once is not supported.",
    "default": "6"
  },
  "itemConsumer":{
    "type": "mindustry.world.consumers.Consume",
    "nullable": true
  },
  "hasLiquidBooster":{
    "type": "boolean"
  },
  "timerUse":{
    "type": "int",
    "default": "timers++"
  }
}