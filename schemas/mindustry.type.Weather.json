  },
  "sound":{
    "type": "arc.audio.Sound",
    "default": "none"
  },
  "soundVol":{
    "type": "float",
    "default": "1"
  },
  "soundVolMin":{
    "type": "float",
    "default": "1"
  },
  "soundVolOscMag":{
    "type": "float",
    "default": "0"
  },
  "soundVolOscScl":{
    "type": "float",
    "default": "0"
  },
  "hidden":{
    "type": "boolean",
    "default": "false"
  },
