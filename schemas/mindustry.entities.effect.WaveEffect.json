{
  "superclass": "mindustry.entities.Effect",
  "doc": "Effect that renders a basic shockwave.\n",
  "colorFrom":{
    "type": "arc.graphics.Color"
  },
  "colorTo":{
    "type": "arc.graphics.Color"
  },
  "lightColor":{
    "type": "arc.graphics.Color",
    "nullable": true
  },
  "sizeFrom":{
    "type": "float",
    "default": "0"
  },
  "sizeTo":{
    "type": "float",
    "default": "0"
  },
  "lightScl":{
    "type": "float",
    "default": "0"
  },
  "lightOpacity":{
    "type": "float",
    "default": "0"
  },
  "sides":{
    "type": "int",
    "default": "-1"
  },
  "rotation":{
    "type": "float",
    "default": "0"
  },
  "strokeFrom":{
    "type": "float",
    "default": "2"
  },
  "strokeTo":{
    "type": "float",
    "default": "2"
  },
  "interp":{
    "type": "arc.math.Interp",
    "default": "linear"
  },
  "lightInterp":{
    "type": "arc.math.Interp",
    "default": "reverse"
  },
  "offsetX":{
    "type": "float"
  },
  "offsetY":{
    "type": "float"
  }
}