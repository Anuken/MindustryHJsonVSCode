{
  "superclass": "mindustry.entities.Effect",
  "doc": "Effect that renders a basic shockwave.\n",
  "colorFrom":{
    "type": "arc.graphics.Color"
  },
  "colorTo":{
    "type": "arc.graphics.Color"
  },
  "lightColor":{
    "type": "arc.graphics.Color",
    "nullable": true
  },
  "sizeFrom":{
    "type": "float",
    "default": "0"
  },
  "sizeTo":{
    "type": "float",
    "default": "0"
  },
  "lightScl":{
    "type": "float",
    "default": "0"
  },
  "lightOpacity":{
    "type": "float",
    "default": "0"
  },
  "sides":{
    "type": "int",
    "default": "-1"
  },
  "rotation":{
    "type": "float",
    "default": "0"
  },
  "strokeFrom":{
    "type": "float",
    "default": "2"
  },
  "strokeTo":{
    "type": "float",
    "default": "2"
  },
  "interp":{
    "type": "arc.math.Interp",
    "default": "linear"
  },
  "lightInterp":{
    "type": "arc.math.Interp",
    "default": "reverse"
  },
  "offsetX":{
    "type": "float"
  },
  "offsetY":{
    "type": "float"
  },
  "id":{
    "type": "int"
  },
  "renderer":{
    "type": "arc.func.Cons<mindustry.entities.Effect$EffectContainer>"
  },
  "lifetime":{
    "type": "float",
    "default": "50"
  },
  "clip":{
    "type": "float",
    "doc": "Clip size."
  },
  "startDelay":{
    "type": "float",
    "doc": "Time delay before the effect starts"
  },
  "baseRotation":{
    "type": "float",
    "doc": "Amount added to rotation"
  },
  "followParent":{
    "type": "boolean",
    "doc": "If true, parent unit is data are followed.",
    "default": "true"
  },
  "rotWithParent":{
    "type": "boolean",
    "doc": "If this and followParent are true, the effect will offset and rotate with the parent's rotation."
  },
  "layer":{
    "type": "float",
    "default": "effect"
  },
  "layerDuration":{
    "type": "float"
  }
}