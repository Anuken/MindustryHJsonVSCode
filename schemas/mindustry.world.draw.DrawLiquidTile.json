{
  "superclass": "mindustry.world.draw.DrawBlock",
  "drawLiquid":{
    "type": "mindustry.type.Liquid"
  },
  "padding":{
    "type": "float"
  },
  "padLeft":{
    "type": "float",
    "default": "-1"
  },
  "padRight":{
    "type": "float",
    "default": "-1"
  },
  "padTop":{
    "type": "float",
    "default": "-1"
  },
  "padBottom":{
    "type": "float",
    "default": "-1"
  },
  "alpha":{
    "type": "float",
    "default": "1"
  },
  "iconOverride":{
    "type": "java.lang.String[]",
    "nullable": true,
    "doc": "If set, the icon is overridden to be these strings, in order. Each string is a suffix.",
    "default": "null"
  }
}