{
  "superclass": "mindustry.world.blocks.power.PowerGenerator",
  "doc": "A generator that just takes in certain items or liquids.\n",
  "itemDuration":{
    "type": "float",
    "doc": "The time in number of ticks during which a single item will produce power.",
    "default": "120"
  },
  "warmupSpeed":{
    "type": "float",
    "default": "05"
  },
  "effectChance":{
    "type": "float",
    "default": "01"
  },
  "generateEffect":{
    "type": "mindustry.entities.Effect",
    "default": "none"
  },
  "consumeEffect":{
    "type": "mindustry.entities.Effect",
    "default": "none"
  },
  "generateEffectRange":{
    "type": "float",
    "default": "3"
  },
  "baseLightRadius":{
    "type": "float",
    "default": "65"
  },
  "outputLiquid":{
    "type": "mindustry.type.LiquidStack",
    "nullable": true
  },
  "explodeOnFull":{
    "type": "boolean",
    "doc": "If true, this block explodes when outputLiquid exceeds capacity.",
    "default": "false"
  },
  "filterItem":{
    "type": "mindustry.world.consumers.ConsumeItemFilter",
    "nullable": true
  },
  "filterLiquid":{
    "type": "mindustry.world.consumers.ConsumeLiquidFilter",
    "nullable": true
  },
  "itemDurationMultipliers":{
    "type": "arc.struct.ObjectFloatMap<mindustry.type.Item>",
    "doc": "Multiplies the itemDuration for a given item."
  }
}