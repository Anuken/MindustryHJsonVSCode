{
  "superclass": "mindustry.entities.part.DrawPart",
  "circle":{
    "type": "boolean",
    "default": "false"
  },
  "hollow":{
    "type": "boolean",
    "default": "false"
  },
  "sides":{
    "type": "int",
    "default": "3"
  },
  "radius":{
    "type": "float",
    "default": "3"
  },
  "radiusTo":{
    "type": "float",
    "default": "3"
  },
  "stroke":{
    "type": "float",
    "default": "3"
  },
  "strokeTo":{
    "type": "float",
    "default": "3"
  },
  "x":{
    "type": "float"
  },
  "y":{
    "type": "float"
  },
  "rotation":{
    "type": "float"
  },
  "moveX":{
    "type": "float"
  },
  "moveY":{
    "type": "float"
  },
  "moveRot":{
    "type": "float"
  },
  "rotateSpeed":{
    "type": "float",
    "default": "0"
  },
  "color":{
    "type": "arc.graphics.Color",
    "default": "white"
  },
  "colorTo":{
    "type": "arc.graphics.Color",
    "nullable": true
  },
  "mirror":{
    "type": "boolean",
    "default": "false"
  },
  "clampProgress":{
    "type": "boolean",
    "default": "true"
  },
  "progress":{
    "type": "mindustry.entities.part.DrawPart$PartProgress",
    "default": "warmup"
  },
  "layer":{
    "type": "float",
    "default": "-1"
  },
  "layerOffset":{
    "type": "float",
    "default": "-1"
  },
  "turretShading":{
    "type": "boolean",
    "doc": "If true, turret shading is used. Don't touch this, it is set up in unit/block init()!"
  },
  "under":{
    "type": "boolean",
    "doc": "If true, the layer is overridden to be under the weapon/turret itself.",
    "default": "false"
  },
  "weaponIndex":{
    "type": "int",
    "doc": "For units, this is the index of the weapon this part gets its progress for.",
    "default": "0"
  },
  "recoilIndex":{
    "type": "int",
    "doc": "Which recoil counter to use. < 0 to use base recoil.",
    "default": "-1"
  }
}