  "pulseIntensity":{
    "type": "float",
    "default": "2"
  },
  "glowScl":{
    "type": "float",
    "default": "3"
  },
  "sparks":{
    "type": "int",
    "default": "7"
  },
  "sparkRange":{
    "type": "float",
    "default": "10"
  },
  "sparkLife":{
    "type": "float",
    "default": "10"
  },
  "sparkRecurrence":{
    "type": "float",
    "default": "10"
  },
  "sparkSpread":{
    "type": "float",
    "default": "10"
  },
  "sparkSize":{
    "type": "float",
    "default": "10"
  },
  "boostHeatColor":{
    "type": "arc.graphics.Color"
  },
  "heatColor":{
    "type": "arc.graphics.Color"
  },
