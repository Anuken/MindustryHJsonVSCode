{
  "superclass": "mindustry.world.Block",
  "laser":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "laserEnd":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "laserCenter":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "laserBoost":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "laserEndBoost":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "laserCenterBoost":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "topRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "glowRegion":{
    "type": "arc.graphics.g2d.TextureRegion"
  },
  "drillTime":{
    "type": "float",
    "default": "200"
  },
  "range":{
    "type": "int",
    "default": "5"
  },
  "tier":{
    "type": "int",
    "default": "1"
  },
  "laserWidth":{
    "type": "float",
    "default": "65"
  },
  "optionalBoostIntensity":{
    "type": "float",
    "doc": "How many times faster the drill will progress when boosted by an optional consumer.",
    "default": "5"
